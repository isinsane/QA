# Copy to .env for local development. .env is gitignored.

APP_ENV=dev

# Created by: ./scripts/dev-db.ps1 init
DATABASE_URL=postgres://postgres@localhost:5433/qa_dev?sslmode=disable
TEST_DATABASE_URL=postgres://postgres@localhost:5433/qa_test?sslmode=disable

HTTP_ADDR=:8090

# Time zones, the Vonage clock, the ticket pull hour and other defaults are
# admin settings in the app (Settings page), not environment variables.

# eDesk Insight QA API (tickets + tags). Blank key = ticket pull disabled.
QA_API_BASE_URL=
QA_API_KEY=

# eDesk official API token (ticket general info). Blank = info panel off.
EDESK_API_TOKEN=

# --- Docker (compose.yaml) ---
# Postgres password for the db container; the app connects to it on its own
# (DATABASE_URL above is only for running locally without Docker).
POSTGRES_PASSWORD=
# Port the portal is published on.
HTTP_PORT=8080
